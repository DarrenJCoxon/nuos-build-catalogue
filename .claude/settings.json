{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-implementation-write.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-design-system-compliance.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-module-discipline.sh"
          }
        ]
      }
    ]
  }
}
