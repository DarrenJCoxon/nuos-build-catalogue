node_modules/
dist/
*.log
.DS_Store

# Verification-gate output
.verify-test.nv
.verify-test.nv/

# The actual index binary is regeneratable from hashes.json + the
# catalogue source; commit hashes.json (small, deterministic) but
# not the multi-MB native store. Backup snapshots from prior reindex
# runs (kept locally for safety) are also excluded.
.nuos-catalogue/index.nv
.nuos-catalogue/index.nv/
.nuos-catalogue/*.nv
.nuos-catalogue/*.nv/
.nuos-catalogue.*-bak/
.nuos-catalogue.*-bak.json

# Per WU 111 D047: the JSON workflow store is local state in Mode 1
# (markdown is canonical). Re-running `nuos-catalogue migrate` against
# the live catalogue is deterministic and produces the same records on
# any machine, so the file does not need to live in git. Mode 2
# (post-WU-113) may revisit if the JSON becomes canonical.
.nuos-catalogue/workflows.json
.nuos-catalogue/active-wu
